# Copy to .env for docker compose. These values are wired into docker-compose.yml.
POSTGRES_USER=cleaning
POSTGRES_PASSWORD=cleaning
POSTGRES_DB=cleaning_log
POSTGRES_PORT=5433

API_PORT=4000
WEB_PORT=5173

# REQUIRED, and there is deliberately no default in docker-compose.yml.
#
# The compose stack runs the API with NODE_ENV=production, and the API refuses to
# start with a secret that is published in this repository — anyone who can read
# the repo could otherwise mint a token for any user and any role, because a
# validly-signed token's claims are trusted as-is.
#
# Generate one:
#   printf 'JWT_SECRET=%s\n' "$(openssl rand -base64 48)" >> .env
JWT_SECRET=
JWT_EXPIRES_IN=15m
