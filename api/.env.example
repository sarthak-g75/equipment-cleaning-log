DATABASE_URL="postgresql://cleaning:cleaning@localhost:5433/cleaning_log?schema=public"
TEST_DATABASE_URL="postgresql://cleaning:cleaning@localhost:5433/cleaning_log_test?schema=public"
PORT=4000
NODE_ENV=development
# Any string of 16+ characters works for local development. The API rejects
# this and the other secrets published in this repo when NODE_ENV=production,
# so a deployed instance needs a real one: openssl rand -base64 48
JWT_SECRET="local-dev-only-not-for-deployment"
JWT_EXPIRES_IN="15m"
CORS_ORIGIN="http://localhost:5173"
